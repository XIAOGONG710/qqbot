{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/exchange.mjs\" check --me claude --quiet",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/exchange.mjs\" check --me claude --quiet --throttle 600",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
